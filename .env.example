# Copy to .env and fill in for local development. Not required to run the
# app — features that need Open Data Hub auth just stay unavailable
# without these (see backend/internal/odhauth).

# Open Data Hub OAuth2 client-credentials (Keycloak, realm "noi").
ODH_CLIENT_ID=
ODH_CLIENT_SECRET=
# Client credentials are realm-specific — a client registered in one realm
# will fail with oauth2 "unauthorized_client" against the other. Pick the
# one matching your client (uncomment it, leave the other commented).
ODH_TOKEN_URL=https://auth.opendatahub.com/auth/realms/noi/protocol/openid-connect/token
# ODH_TOKEN_URL=https://auth.opendatahub.testingmachine.eu/auth/realms/noi/protocol/openid-connect/token
